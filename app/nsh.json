{
  "name": "AgentsSync",
  "id": "dev.gaubee.agents-sync",
  "version": "1.0.0",
  "build": 1,
  "rust": ".",
  "theme": "./theme.json",
  "resolve": {
    "alias": {
      "@": "./"
    }
  },
  "macos": {
    "activationPolicy": "accessory"
  },
  "window": {
    "defaultSize": {
      "width": 380,
      "height": 500
    },
    "defaultVisible": false,
    "frame": "none",
    "resizable": false,
    "movable": false,
    "minimizable": false,
    "maximizable": false,
    "closable": false,
    "closeOnEscape": false,
    "level": "floating",
    "taskbar": false,
    "workspaces": "all",
    "transparent": true,
    "backdrop": "none",
    "shadow": true,
    "titleBar": {
      "style": "hidden"
    }
  }
}
